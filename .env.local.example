# Copy this file to .env.local and fill in the values for your machine.
# .env.local is gitignored — never commit actual paths or secrets.

# ── ComfyUI ────────────────────────────────────────────────────────────────────
# URL where ComfyUI is running (default: http://localhost:8188)
COMFYUI_BASE_URL=http://localhost:8188

# ComfyUI input directory — where uploaded images are staged for LoadImage nodes.
# Windows path (used by the app when writing files):
COMFYUI_INPUT_DIR_WINDOWS=C:\Users\YOUR_USERNAME\ComfyUI\input
# WSL/Linux path (only needed if running the Next.js server inside WSL):
# COMFYUI_INPUT_DIR=/mnt/c/Users/YOUR_USERNAME/ComfyUI/input

# ComfyUI output directory (currently unused by the app, kept for reference):
COMFYUI_OUTPUT_DIR_WINDOWS=C:\Users\YOUR_USERNAME\ComfyUI\output
# COMFYUI_OUTPUT_DIR=/mnt/c/Users/YOUR_USERNAME/ComfyUI/output

# ── YOLO hand detection ────────────────────────────────────────────────────────
# Path to the Python executable that has ultralytics + opencv-python installed.
# You can reuse an existing env (e.g. your gpu/ml env) or create a new one:
#   conda create -n yolo python=3.9
#   conda activate yolo
#   pip install ultralytics opencv-python
# Or install into an existing env (e.g. "gpu"):
#   C:\Users\YOUR_USERNAME\miniconda3\envs\gpu\python.exe -m pip install ultralytics opencv-python
YOLO_PYTHON=C:\Users\YOUR_USERNAME\miniconda3\envs\gpu\python.exe

# Path to the YOLO weights (.pt file).
YOLO_MODEL_PATH=C:\Users\YOUR_USERNAME\path\to\model\best.pt

# Path to the detection script — only override if you move it from scripts/.
# YOLO_SCRIPT_PATH=C:\Users\YOUR_USERNAME\semrob\scripts\yolo_detect.py

# ── OpenAI (optional, only for API inpainting mode) ───────────────────────────
# OPENAI_API_KEY=sk-...
